#!/bin/sh
# Local qualification; remote exact-head CI and reviews remain mandatory.
set -eu

branch=$(git symbolic-ref --quiet --short HEAD) || exit 1
case "$branch" in main|next) echo 'pre-push: protected branch' >&2; exit 1 ;; esac
git fetch --quiet origin next || { echo 'pre-push: cannot refresh next' >&2; exit 1; }
BASE=$(git rev-parse --verify refs/remotes/origin/next^{commit})
HEAD=$(git rev-parse --verify HEAD^{commit})
git merge-base --is-ancestor "$BASE" "$HEAD" || {
  echo 'pre-push: rebase on current next and requalify' >&2; exit 1;
}
policy=$(mktemp)
selector=$(mktemp)
trap 'rm -f "$policy" "$selector"' EXIT HUP INT TERM
git show "$BASE:.env.ci" > "$policy"
if git cat-file -e "$BASE:scripts/pr_review_budget.py" 2>/dev/null; then
  git show "$BASE:scripts/pr_review_budget.py" > "$selector"
else
  cp scripts/pr_review_budget.py "$selector"
fi
title=$(git log --reverse --format=%s "$BASE..$HEAD" | sed -n '1p')
budget=$(python3 -B "$selector" --policy "$policy" --title "$title" --branch "$branch") || exit 1
export FLOWSTATE_PR_MAX_LINES="$budget"
# Changed-path budget: same selector/title agreement; protected bases that
# predate the --files flag fall back to the reviewed default of 10 paths.
files=$(python3 -B "$selector" --policy "$policy" --title "$title" --branch "$branch" --files 2>/dev/null) || files="${FLOWSTATE_PR_MAX_FILES:-10}"
export FLOWSTATE_PR_MAX_FILES="$files"
python3 -B scripts/pr_size.py --base "$BASE" --head "$HEAD"

python3 -B scripts/check_code_contract.py --base "$BASE"
python3 -B scripts/check_test_contract.py --base "$BASE"
python3 -B -m scripts.check_python_contract --base "$BASE"
# Subject policy on every pushed commit (commit-msg validates locally
# created commits; this also covers amended or transplanted histories).
git log --format=%s "$BASE..$HEAD" | while IFS= read -r subject; do
  python3 -B scripts/check_commit_subject.py --header "$subject" || {
    echo "pre-push: invalid commit subject: $subject" >&2
    exit 1
  }
done
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
    case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
    # The preflight below verifies only the checked-out HEAD. Another tip is
    # still admission-checked here, but say plainly that it was not preflighted.
    [ "$local_sha" = "$HEAD" ] || echo "pre-push: warning: $local_ref is not the checked-out HEAD; the local CI preflight does not cover it" >&2
    tip_title=$(git log --reverse --format=%s "$BASE..$local_sha" | sed -n 1p)
    budget=$(python3 -B "$selector" --policy "$policy" --title "$tip_title" --branch "$local_ref" 2>/dev/null) || budget="$FLOWSTATE_PR_MAX_LINES"
    files=$(python3 -B "$selector" --policy "$policy" --title "$tip_title" --branch "$local_ref" --files 2>/dev/null) || files="$FLOWSTATE_PR_MAX_FILES"
    FLOWSTATE_PR_MAX_LINES="$budget" FLOWSTATE_PR_MAX_FILES="$files" make check-admission-commits BASE_SHA="$BASE" HEAD_SHA="$local_sha"
done
# Most blocking CI jobs, on the committed, checked-out HEAD: a push that would
# fail lint, the security gate, the docs contract, vet on another OS or the
# tests fails here first. It refuses a dirty tree, since CI sees only what is
# committed.
make preflight BASE_SHA="$BASE"
python3 -B -m unittest discover -s scripts/tests -p 'test_review_handoff.py'
python3 -B -m unittest discover -s scripts/tests -p 'test_pr_review_budget.py'
printf 'pre-push: qualified %s against %s (%s lines, %s files)\n' "$HEAD" "$BASE" "$FLOWSTATE_PR_MAX_LINES" "$FLOWSTATE_PR_MAX_FILES"
