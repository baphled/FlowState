#!/bin/sh
# Enforce exact committed source boundaries before pushing to next.
set -eu
BASE=$(git rev-parse origin/next)
HEAD=$(git rev-parse HEAD)
python3 -B scripts/pr_size.py --base "$BASE" --head "$HEAD"
python3 -B -m unittest discover -s scripts/tests -p test_code_contract.py
python3 -B scripts/check_code_contract.py --base "$BASE"
