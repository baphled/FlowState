#!/bin/sh
# Validate the commit subject against the committed commitlint policy
# (type-enum, scope-enum, case, lengths) so invalid titles fail at
# commit time instead of in CI's Lint Commits / PR Policy jobs.
MSG_FILE="$1"
[ -n "$MSG_FILE" ] || exit 0
python3 -B scripts/check_commit_subject.py --message-file "$MSG_FILE" || exit 1
