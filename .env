# Default Docker Compose environment for the FlowState full stack.
#
# Compose reads this file automatically, so a plain `docker compose up -d`
# starts EVERY service (COMPOSE_PROFILES=all below) — profiles only filter
# when explicitly overridden on the CLI.
#
# Repos are resolved relative to this worktree (the sibling bare repos);
# override with absolute paths or file:// URLs if your layout differs.

COMPOSE_PROFILES=all

# Backend source (bare repo + branch to build from).
BE_REPO=../FlowState.git
BE_BRANCH=main

# UI source (separate repo — flowstate-web).
FE_REPO=../flowstate-web.git
FE_BRANCH=main
