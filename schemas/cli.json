{
  "serve-health": {
    "type": "object",
    "additionalProperties": false,
    "required": ["status"],
    "properties": { "status": { "type": "string" } }
  },
  "session-new": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "parent_id": {
        "type": "string"
      }
    }
  },
  "session-cancel": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "session-list": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at_utc",
        "updated_at_utc",
        "status",
        "provider",
        "model_id",
        "harness",
        "config_sha256",
        "parent_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at_utc": {
          "type": "string"
        },
        "updated_at_utc": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        }
      }
    }
  },
  "session-events": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "seq",
        "created_at_utc",
        "actor",
        "type",
        "payload",
        "payload_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "created_at_utc": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "payload_sha256": {
          "type": "string"
        }
      }
    }
  },
  "session-replay": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "seq",
        "created_at_utc",
        "actor",
        "type",
        "payload",
        "payload_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "created_at_utc": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "payload_sha256": {
          "type": "string"
        }
      }
    }
  },
  "receipt-validate": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "verdict"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "valid",
            "invalid"
          ]
        }
      }
    }
  },
  "session-budget": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "session_id",
      "reserved",
      "budget_pool",
      "available"
    ],
    "properties": {
      "session_id": {
        "type": "string"
      },
      "reserved": {
        "type": "integer"
      },
      "budget_pool": {
        "type": [
          "integer",
          "null"
        ]
      },
      "available": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  },
  "session-message": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "session_id",
      "sender"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "sender": {
        "type": "string"
      }
    }
  },
  "session-tool": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "session_id",
      "tool",
      "ok",
      "result"
    ],
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tool": {
        "type": "string"
      },
      "ok": {
        "const": true
      },
      "result": true
    }
  },
  "swarm-validate": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "valid"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "valid": {
        "const": true
      }
    }
  },
  "swarm-run-execute": {
    "type": "object",
    "additionalProperties": false,
    "required": ["manifest", "run_id", "status", "reason", "coordinator_session", "children", "gates", "packets"],
    "properties": {
      "manifest": { "type": "string" },
      "run_id": { "type": "string" },
      "status": { "enum": ["accepted", "not_accepted", "gate_failed", "failed", "cancelled"] },
      "reason": { "type": "string" },
      "coordinator_session": { "type": "string" },
      "children": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "profile", "packet", "status", "turns"],
          "properties": {
            "id": { "type": "string" },
            "profile": { "type": "string" },
            "packet": { "type": "string" },
            "status": { "type": "string" },
            "turns": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "gates": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "passed", "interrupted"],
          "properties": {
            "name": { "type": "string" },
            "passed": { "type": "boolean" },
            "interrupted": { "type": "boolean" }
          }
        }
      },
      "packets": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "admitted", "reason", "evidence"],
          "properties": {
            "id": { "type": "string" },
            "admitted": { "type": "boolean" },
            "reason": { "type": "string" },
            "evidence": { "type": "string" }
          }
        }
      }
    }
  },
  "swarm-run": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "manifest",
      "admitted",
      "accepted",
      "children"
    ],
    "properties": {
      "manifest": {
        "type": "string"
      },
      "admitted": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "accepted": {
        "type": "boolean"
      },
      "children": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packet",
            "session",
            "status",
            "parent_id"
          ],
          "properties": {
            "packet": {
              "type": "string"
            },
            "session": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "parent_id": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "agents-list": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "tools", "delegates", "model", "max_turns", "source", "path", "sha256"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "delegates": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" },
        "max_turns": { "type": "integer" },
        "context_window": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "source": { "type": "string", "enum": ["user", "project"] },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    }
  },
  "agents-validate": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path", "ok"],
    "properties": {
      "path": { "type": "string" },
      "ok": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "store-info": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "journal_mode",
      "foreign_keys_enforced",
      "driver",
      "driver_version",
      "sqlite_version",
      "path",
      "go_version",
      "tables"
    ],
    "properties": {
      "schema_version": { "type": "integer" },
      "journal_mode": { "type": "string" },
      "foreign_keys_enforced": { "type": "boolean" },
      "driver": { "type": "string" },
      "driver_version": { "type": "string" },
      "sqlite_version": { "type": "string" },
      "path": { "type": "string" },
      "go_version": { "type": "string" },
      "tables": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "foreign_keys"],
          "properties": {
            "name": { "type": "string" },
            "foreign_keys": { "type": "integer" }
          }
        }
      }
    }
  },
  "session-compact": {
    "type": "object",
    "additionalProperties": false,
    "required": ["session", "event_seq", "first_kept_seq", "tokens_before", "tokens_after", "reason", "model", "usage"],
    "properties": {
      "session": { "type": "string" },
      "event_seq": { "type": "integer", "minimum": 1 },
      "first_kept_seq": { "type": "integer", "minimum": 1 },
      "tokens_before": { "type": "integer", "minimum": 0 },
      "tokens_after": { "type": "integer", "minimum": 0 },
      "reason": { "type": "string", "enum": ["manual"] },
      "model": { "type": "string" },
      "usage": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"],
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "cache_read_tokens": { "type": "integer", "minimum": 0 },
          "cache_write_tokens": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "session-doctor": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "session_id",
      "status",
      "crashed",
      "run_activity",
      "pending_messages",
      "reserved",
      "budget_pool",
      "available",
      "usage"
    ],
    "properties": {
      "session_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "crashed": {
        "type": "boolean"
      },
      "run_activity": {
        "type": "boolean"
      },
      "pending_messages": {
        "type": "integer"
      },
      "reserved": {
        "type": "integer"
      },
      "budget_pool": {
        "type": [
          "integer",
          "null"
        ]
      },
      "available": {
        "type": [
          "integer",
          "null"
        ]
      },
      "finish_reason": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "context_window": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokens", "source"],
        "properties": {
          "tokens": { "type": ["integer", "null"], "minimum": 1 },
          "source": { "type": "string", "enum": ["profile", "config", "table", "unknown"] }
        }
      },
      "warnings": {
        "type": "array",
        "items": { "type": "string" }
      },
      "usage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_write_tokens",
          "turns_reported",
          "turns_total",
          "last_context_tokens"
        ],
        "properties": {
          "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "turns_reported": { "type": "integer", "minimum": 0 },
          "turns_total": { "type": "integer", "minimum": 0 },
          "last_context_tokens": { "type": ["integer", "null"], "minimum": 0 }
        }
      },
      "compactions": {
        "description": "Present in the CLI output; the HTTP doctor route does not carry it yet.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "invalid",
          "last_tokens_after",
          "summaries_reported",
          "summary_input_tokens",
          "summary_output_tokens"
        ],
        "properties": {
          "count": { "type": "integer", "minimum": 0 },
          "invalid": { "type": "integer", "minimum": 0 },
          "last_tokens_after": { "type": ["integer", "null"], "minimum": 0 },
          "summaries_reported": { "type": "integer", "minimum": 0 },
          "summary_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "summary_output_tokens": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
