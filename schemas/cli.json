{
  "serve-health": {
    "type": "object",
    "additionalProperties": false,
    "required": ["status"],
    "properties": { "status": { "type": "string" } }
  },
  "session-new": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "parent_id": {
        "type": "string"
      }
    }
  },
  "session-cancel": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "session-list": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at_utc",
        "updated_at_utc",
        "status",
        "provider",
        "model_id",
        "harness",
        "config_sha256",
        "parent_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at_utc": {
          "type": "string"
        },
        "updated_at_utc": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        }
      }
    }
  },
  "session-events": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "seq",
        "created_at_utc",
        "actor",
        "type",
        "payload",
        "payload_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "created_at_utc": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "payload_sha256": {
          "type": "string"
        }
      }
    }
  },
  "session-replay": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "seq",
        "created_at_utc",
        "actor",
        "type",
        "payload",
        "payload_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "created_at_utc": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "payload_sha256": {
          "type": "string"
        }
      }
    }
  },
  "receipt-validate": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "verdict"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "valid",
            "invalid"
          ]
        }
      }
    }
  },
  "session-budget": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "session_id",
      "reserved",
      "budget_pool",
      "available"
    ],
    "properties": {
      "session_id": {
        "type": "string"
      },
      "reserved": {
        "type": "integer"
      },
      "budget_pool": {
        "type": [
          "integer",
          "null"
        ]
      },
      "available": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  },
  "session-message": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "session_id",
      "sender"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "sender": {
        "type": "string"
      }
    }
  },
  "session-tool": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "session_id",
      "tool",
      "ok",
      "result"
    ],
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tool": {
        "type": "string"
      },
      "ok": {
        "const": true
      },
      "result": true
    }
  },
  "swarm-validate": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "valid"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "valid": {
        "const": true
      }
    }
  },
  "swarm-run": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "manifest",
      "admitted",
      "accepted",
      "children"
    ],
    "properties": {
      "manifest": {
        "type": "string"
      },
      "admitted": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "accepted": {
        "type": "boolean"
      },
      "children": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packet",
            "session",
            "status",
            "parent_id"
          ],
          "properties": {
            "packet": {
              "type": "string"
            },
            "session": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "parent_id": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "agents-list": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "tools", "delegates", "model", "max_turns", "source", "path", "sha256"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "delegates": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" },
        "max_turns": { "type": "integer" },
        "source": { "type": "string", "enum": ["user", "project"] },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    }
  },
  "agents-validate": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path", "ok"],
    "properties": {
      "path": { "type": "string" },
      "ok": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "store-info": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "journal_mode",
      "foreign_keys_enforced",
      "driver",
      "driver_version",
      "sqlite_version",
      "path",
      "go_version",
      "tables"
    ],
    "properties": {
      "schema_version": { "type": "integer" },
      "journal_mode": { "type": "string" },
      "foreign_keys_enforced": { "type": "boolean" },
      "driver": { "type": "string" },
      "driver_version": { "type": "string" },
      "sqlite_version": { "type": "string" },
      "path": { "type": "string" },
      "go_version": { "type": "string" },
      "tables": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "foreign_keys"],
          "properties": {
            "name": { "type": "string" },
            "foreign_keys": { "type": "integer" }
          }
        }
      }
    }
  },
  "session-doctor": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "session_id",
      "status",
      "crashed",
      "run_activity",
      "pending_messages",
      "reserved",
      "budget_pool",
      "available"
    ],
    "properties": {
      "session_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "crashed": {
        "type": "boolean"
      },
      "run_activity": {
        "type": "boolean"
      },
      "pending_messages": {
        "type": "integer"
      },
      "reserved": {
        "type": "integer"
      },
      "budget_pool": {
        "type": [
          "integer",
          "null"
        ]
      },
      "available": {
        "type": [
          "integer",
          "null"
        ]
      },
      "finish_reason": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      }
    }
  }
}
