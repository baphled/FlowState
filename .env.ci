# Reviewed CI budget (loaded from the protected target branch, never from a PR).
FLOWSTATE_PR_MAX_LINES=600
# Feature packets carry a wider bound: complete surfaces (transport adapters,
# new packages) need schema + tests + wiring in one reviewed unit.
FLOWSTATE_PR_MAX_LINES_FEAT=1200
# Docs-only packets carry their own bound (overrides FLOWSTATE_PR_MAX_LINES for docs commits).
FLOWSTATE_PR_MAX_LINES_DOCS=2000
# Changed-path bound for every kind (features may widen via FLOWSTATE_PR_MAX_FILES_FEAT).
FLOWSTATE_PR_MAX_FILES=10
# Feature packets may spread one complete surface across a few more paths.
FLOWSTATE_PR_MAX_FILES_FEAT=15
