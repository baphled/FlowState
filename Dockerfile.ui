# Dockerfile for the FlowState Vue 3 UI (flowstate-web — a SEPARATE repo).
#
# Source is NOT cloned inside the container: `make docker-build` clones the
# requested branch into build/ui-src (worktree-local) and this image simply
# COPYs it in. See Makefile target `docker-src`.

FROM node:22-bookworm-slim AS builder

COPY ui-src /src
WORKDIR /src

RUN --mount=type=cache,target=/root/.npm \
    npm ci
RUN npm run build

# ---------------------------------------------------------------------------
# Runtime — static assets served by nginx with API proxy to the backend.
FROM nginx:1.27-alpine

COPY --from=builder /src/dist /usr/share/nginx/html
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s CMD wget -q -O- http://127.0.0.1/ >/dev/null || exit 1
